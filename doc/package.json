{
  "name": "@takazudo/zudo-design-token-lint-doc",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "zfb dev",
    "build": "zfb build",
    "preview": "zfb preview",
    "check": "zfb check",
    "check:html": "html-validate \"dist/**/*.html\"",
    "check:pin-parity": "node scripts/check-pin-parity.mjs",
    "check:wrangler-pin": "node scripts/check-wrangler-pin.mjs",
    "check:links": "node scripts/check-links.js --strict-broken --allowlist=.check-links-allowlist",
    "check:template-drift": "bash scripts/check-template-drift.sh",
    "// --ignore REPLACES the formatter's defaults rather than appending, so they are repeated here. The tail entry skips docs/claude*: gitignored MDX regenerated on every build, unformatted by design — without it the check fails on any run following a build.": "",
    "format:md": "pnpm dlx @takazudo/mdx-formatter --write \"src/content/**/*.{md,mdx}\" --ignore \"node_modules/**,dist/**,build/**,.git/**,worktrees/**,src/content/docs/claude*/**\"",
    "format:md:check": "pnpm dlx @takazudo/mdx-formatter --check \"src/content/**/*.{md,mdx}\" --ignore \"node_modules/**,dist/**,build/**,.git/**,worktrees/**,src/content/docs/claude*/**\"",
    "setup:doc-skill": "bash scripts/setup-doc-skill.sh",
    "setup:doc-skill-silent": "bash scripts/setup-doc-skill.sh --silent",
    "b4push": "bash scripts/run-b4push.sh"
  },
  "dependencies": {
    "@takazudo/zfb": "2.7.1",
    "@takazudo/zfb-runtime": "2.7.1",
    "@takazudo/zfb-md-wasm": "2.7.1",
    "@takazudo/zfb-adapter-cloudflare": "2.7.1",
    "@takazudo/zudo-doc": "^5.8.0",
    "@takazudo/zudo-doc-history-server": "^5.8.0",
    "@takazudo/zdtp": "0.4.12",
    "zod": "^4.3.6",
    "preact": "^10.29.1",
    "preact-render-to-string": "^6.6.6",
    "shiki": "^4.0.2",
    "@shikijs/transformers": "^4.0.0",
    "clsx": "^2.1.0",
    "gray-matter": "^4.0.0",
    "mermaid": "^11.12.3",
    "remark-cjk-friendly": "^2.0.1",
    "remark-directive": "^3.0.0",
    "katex": "^0.16.38",
    "minisearch": "^7.2.0",
    "diff": "^8.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "create-zudo-doc": "^4.5.0",
    "html-validate": "^10.0.0",
    "pagefind": "^1.4.0",
    "sharp": "^0.34.5",
    "tsx": "^4.21.0",
    "wrangler": "4.85.0"
  }
}
