{
  "projectName": "zudo-design-token-lint",
  "defaultLang": "en",
  "colorSchemeMode": "light-dark",
  "lightScheme": "Default Light",
  "darkScheme": "Default Dark",
  "defaultMode": "dark",
  "respectPrefersColorScheme": true,
  "themePack": "bauhaus",
  "features": [
    "search",
    "sidebarFilter",
    "imageEnlarge",
    "dynamicPageTransition",
    "footerCopyright",
    "i18n",
    "claudeResources",
    "claudeSkills",
    "designTokenPanel",
    "sidebarResizer",
    "sidebarToggle",
    "versioning",
    "docHistory",
    "skillSymlinker",
    "changelog",
    "llmsTxt",
    "bodyFootUtil"
  ],
  "cjkFriendly": true,
  "packageManager": "pnpm",
  "githubUrl": "https://github.com/Takazudo/zudo-design-token-lint",
  "headerRightItems": [
    { "type": "component", "component": "github-link" },
    { "type": "component", "component": "theme-toggle" },
    { "type": "component", "component": "search" },
    { "type": "component", "component": "language-switcher" },
    { "type": "component", "component": "version-switcher" }
  ],
  "metaTags": {
    "description": true,
    "keywords": "design token, Takazudo, lint, frontend, utility",
    "ogImage": "/img/ogp.png",
    "ogSiteName": true,
    "twitterCard": "summary_large_image",
    "twitterCreator": "@Takazudo"
  }
}
